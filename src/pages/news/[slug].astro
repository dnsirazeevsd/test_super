---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsGallery from '../../components/NewsGallery';
import siteData from '../../data/site.json';
import { getImageAsset, getTelegramUrl, isTelegramEnabled, type ImageAsset } from '../../lib/catalog';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteOrigin = Astro.site?.origin || siteData.brand.domain;
const primaryPhone = siteData.contacts.phones[0];
const telegramHref = getTelegramUrl();
const showTelegram = isTelegramEnabled() && Boolean(telegramHref);

const galleryAssets = post.data.images
  .map((key: string) => getImageAsset(key))
  .filter(Boolean) as ImageAsset[];

const ogImage = galleryAssets[0]?.src || '/og-default.jpg';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.seoTitle,
  description: post.data.seoDescription,
  datePublished: post.data.date,
  dateModified: post.data.date,
  image: galleryAssets.map((img) => `${siteOrigin}${img.src}`),
  author: {
    '@type': 'Organization',
    name: siteData.brand.seoName,
  },
  publisher: {
    '@type': 'Organization',
    name: siteData.brand.seoName,
    logo: {
      '@type': 'ImageObject',
      url: `${siteOrigin}/apple-touch-icon.png`,
    },
  },
  mainEntityOfPage: `${siteOrigin}/news/${post.id}/`,
};
---

<BaseLayout
  title={`${post.data.seoTitle} | SUPER STORE СПб`}
  description={post.data.seoDescription}
  canonicalPath={`/news/${post.id}/`}
  ogImage={ogImage}
  ogType="article"
  jsonLd={articleSchema}
>
  <article class="shell max-w-4xl pt-10 lg:pt-16 pb-20 lg:pb-28 space-y-10">
    <nav aria-label="Хлебные крошки" class="type-small text-fg-muted flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-brand transition-colors no-underline">Главная</a>
      <span aria-hidden="true">/</span>
      <a href="/news/" class="hover:text-brand transition-colors no-underline">Новости и статьи</a>
      <span aria-hidden="true">/</span>
      <span class="text-fg truncate max-w-[240px] sm:max-w-md">{post.data.seoTitle}</span>
    </nav>

    <header class="space-y-3">
      <time
        datetime={post.data.date}
        class="type-small text-fg-muted tabular-nums block"
      >
        {post.data.displayDate}
      </time>
      <h1 class="type-display !text-[2rem] lg:!text-[3rem] m-0">
        {post.data.displayTitle || post.data.title}
      </h1>
    </header>

    <div class="space-y-8 pt-6" style="border-top: 1px solid var(--divider);">
      <div class="prose prose-slate max-w-[65ch] prose-a:text-brand prose-li:my-1">
        <Content />
      </div>

      {galleryAssets.length > 0 && (
        <div class="pt-6 space-y-3" style="border-top: 1px solid var(--divider);">
          <h2 class="type-small font-semibold text-fg-muted m-0">
            Иллюстрации к публикации (нажмите для увеличения)
          </h2>
          <NewsGallery client:idle images={galleryAssets} title={post.data.seoTitle} />
        </div>
      )}
    </div>

    <div
      class="pt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6"
      style="border-top: 1px solid var(--divider);"
    >
      <div class="space-y-1 max-w-[52ch]">
        <h2 class="text-lg font-semibold text-fg m-0">Остались вопросы по теме публикации?</h2>
        <p class="type-small text-fg-muted m-0">
          Позвоните нашим менеджерам или приезжайте в ТРЦ «РИО» (ул. Фучика, д. 2).
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 shrink-0">
        <a
          href={primaryPhone.href}
          data-goal="click_phone"
          class="btn"
        >
          Позвонить
        </a>
        {showTelegram ? (
          <a
            href={telegramHref}
            target="_blank"
            rel="noopener noreferrer"
            data-goal="click_telegram"
            class="arrow-link"
          >
            Написать в Telegram
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ) : (
          <a href="/news/" class="arrow-link">
            Ко всем новостям
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
