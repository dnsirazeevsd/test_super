---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const posts = (await getCollection('news')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout
  title="Новости и статьи магазина SUPER STORE — Санкт-Петербург, ТРЦ «РИО»"
  description="Полезные публикации магазина техники SUPER STORE в Санкт-Петербурге: установка приложений на iPhone, программа Trade-In, перенос данных, цены на iPhone 18 Pro и анонс iPhone Duo."
  canonicalPath="/news/"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14 space-y-10">
    <nav aria-label="Хлебные крошки" class="text-xs font-medium text-fg-muted flex items-center gap-2">
      <a href="/" class="hover:text-brand-link">Главная</a>
      <span aria-hidden="true">/</span>
      <span class="text-fg">Новости и статьи</span>
    </nav>

    <div class="max-w-2xl space-y-2">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-fg tracking-tight">
        Новости и статьи
      </h1>
      <p class="text-base text-fg-muted">
        Обзоры новинок, ответы на частые вопросы об iPhone и новости офлайн-магазина SUPER STORE.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post, idx) => (
        <article class="group rounded-3xl bg-bg-card border border-line shadow-card overflow-hidden flex flex-col">
          <a href={`/news/${post.id}/`} class="aspect-[4/3] bg-white overflow-hidden block">
            <OptimizedImage
              imageKey={post.data.cover || post.data.images[0]}
              alt={post.data.displayTitle || post.data.title}
              priority={idx === 0}
              sizes="(max-width: 768px) 92vw, 380px"
              class="w-full h-full"
              imgClass="w-full h-full object-cover group-hover:scale-[1.03] transition-transform"
            />
          </a>
          <div class="p-6 flex-1 flex flex-col justify-between gap-4">
            <div class="space-y-2.5">
              <div class="flex items-center justify-between text-xs text-fg-muted">
                <time datetime={post.data.date} class="font-semibold tabular-nums">
                  {post.data.displayDate}
                </time>
                {post.data.images.length > 1 && (
                  <span>{post.data.images.length} фото</span>
                )}
              </div>
              <h2 class="text-xl font-bold text-fg leading-snug">
                <a href={`/news/${post.id}/`} class="hover:text-brand-link transition-colors">
                  {post.data.displayTitle || post.data.title}
                </a>
              </h2>
              <p class="text-sm text-fg-muted leading-relaxed">{post.data.excerpt}</p>
            </div>
            <a href={`/news/${post.id}/`} class="text-sm font-bold text-brand-link hover:underline">
              Читать полностью →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
