---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';
import { getTelegramUrl, getWhatsAppUrl, isTelegramEnabled, isWhatsAppEnabled } from '../lib/catalog';

const primaryPhone = siteData.contacts.phones[0];
const telegramHref = getTelegramUrl();
const showTelegram = isTelegramEnabled() && Boolean(telegramHref);
const whatsappHref = getWhatsAppUrl();
const showWhatsApp = isWhatsAppEnabled() && Boolean(whatsappHref);
---

<BaseLayout
  title="Страница не найдена (404) — SUPER STORE"
  description="Запрашиваемая страница не найдена. Перейдите в каталог техники SUPER STORE или свяжитесь с менеджером магазина в ТРЦ «РИО»."
  canonicalPath="/404"
>
  <section class="pt-16 lg:pt-24 pb-24 lg:pb-32">
    <div class="shell max-w-[60ch] space-y-6">
      <p class="type-small font-semibold text-fg-muted m-0">Ошибка 404</p>
      <h1 class="type-display !text-[2.25rem] lg:!text-[3.25rem] m-0">
        Такой страницы нет, но техника в наличии
      </h1>
      <p class="type-body text-fg-muted m-0">
        Возможно, ссылка устарела после обновления сайта. Откройте каталог устройств или позвоните
        нам — поможем найти нужную модель.
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-2">
        <a href="/catalog/" class="btn">
          Перейти в каталог
        </a>
        {showTelegram ? (
          <a
            href={telegramHref}
            target="_blank"
            rel="noopener noreferrer"
            data-goal="click_telegram"
            class="arrow-link"
          >
            Написать в Telegram
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ) : (
          <a
            href={primaryPhone.href}
            data-goal="click_phone"
            class="arrow-link tabular-nums whitespace-nowrap"
          >
            {primaryPhone.display}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
        {showWhatsApp && (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            data-goal="click_whatsapp"
            class="arrow-link"
          >
            Написать в WhatsApp
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
          <a
            href={primaryPhone.href}
            data-goal="click_phone"
            class="arrow-link tabular-nums whitespace-nowrap"
          >
            {primaryPhone.display}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
