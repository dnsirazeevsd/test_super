---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductConfigurator from '../../../components/ProductConfigurator';
import siteData from '../../../data/site.json';
import {
  MANIFEST,
  type ProductModelGroup,
  formatPrice,
  getDeliveryConditions,
  getDeliveryOptions,
  getGroupedModels,
  getImageAsset,
  getTelegramUrl,
  getWhatsAppUrl,
  getTrustStrip,
  isTelegramEnabled,
  isWhatsAppEnabled,
} from '../../../lib/catalog';

export function getStaticPaths() {
  const allGroups = getGroupedModels();
  return allGroups.map((group) => ({
    params: {
      category: group.category,
      model: group.modelSlug,
    },
    props: { group },
  }));
}

interface Props {
  group: ProductModelGroup;
}

const { group } = Astro.props;
const siteOrigin = Astro.site?.origin || siteData.brand.domain;
const primaryAsset = getImageAsset(group.defaultImageKey);
const ogImage = primaryAsset ? primaryAsset.src : '/og-default.jpg';

const minPrice = group.minPrice;
const cheapest = group.items.filter((i) => i.price === minPrice);
const defaultConfig =
  cheapest.find((i) => i.color === 'Glacier') || cheapest[0] || group.items[0];

const pricePhrase = group.hasMultipleConfigs
  ? `от ${formatPrice(group.minPrice)}`
  : formatPrice(group.minPrice);

const availabilityUrl = group.inStock
  ? 'https://schema.org/InStock'
  : 'https://schema.org/OutOfStock';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: group.modelTitle,
  description: `${group.modelTitle} — новый, запечатанный, в наличии в Санкт-Петербурге в офлайн-магазине SUPER STORE (ТРЦ «РИО»). Подарок при покупке каждого устройства.`,
  image: primaryAsset ? `${siteOrigin}${primaryAsset.src}` : `${siteOrigin}/og-default.jpg`,
  brand: {
    '@type': 'Brand',
    name:
      group.category === 'samsung' || group.category === 'watch'
        ? 'Samsung'
        : group.category === 'consoles'
        ? 'Sony'
        : 'Apple',
  },
  offers:
    group.items.length > 1
      ? {
          '@type': 'AggregateOffer',
          priceCurrency: 'RUB',
          lowPrice: group.minPrice,
          highPrice: group.maxPrice,
          offerCount: group.items.length,
          availability: availabilityUrl,
          offers: group.items.map((sku) => ({
            '@type': 'Offer',
            name: sku.title,
            price: sku.price,
            priceCurrency: 'RUB',
            availability: sku.inStock
              ? 'https://schema.org/InStock'
              : 'https://schema.org/OutOfStock',
            itemCondition: 'https://schema.org/NewCondition',
            url: `${siteOrigin}${group.url}`,
          })),
        }
      : {
          '@type': 'Offer',
          price: group.minPrice,
          priceCurrency: 'RUB',
          availability: availabilityUrl,
          itemCondition: 'https://schema.org/NewCondition',
          url: `${siteOrigin}${group.url}`,
        },
};
---

<BaseLayout
  title={`${defaultConfig.title} — цена ${pricePhrase} в СПб | SUPER STORE ТРЦ «РИО»`}
  description={`${defaultConfig.title} в наличии в Санкт-Петербурге (${pricePhrase}). Новый, запечатанный, проверка при вас в ТРЦ «РИО», Trade-In, кредит и подарок при покупке.`}
  canonicalPath={group.url}
  ogImage={ogImage}
  ogType="product"
  lcpAsset={primaryAsset}
  jsonLd={productSchema}
>
  <section class="pt-10 lg:pt-16 pb-20 lg:pb-32">
    <div class="shell">
      <!-- Minimal breadcrumb -->
      <nav
        aria-label="Хлебные крошки"
        class="type-small text-fg-muted flex flex-wrap items-center gap-2 mb-10"
      >
        <a href="/catalog/" class="hover:text-brand transition-colors no-underline">Каталог</a>
        <span aria-hidden="true">/</span>
        <a href={`/catalog/${group.category}/`} class="hover:text-brand transition-colors no-underline">
          {group.categoryTitle}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-fg">{group.modelTitle}</span>
      </nav>

      <ProductConfigurator
        client:load
        modelTitle={group.modelTitle}
        favId={`${group.category}/${group.modelSlug}`}
        items={group.items}
        manifest={MANIFEST}
        primaryPhoneDisplay={siteData.contacts.phones[0].display}
        primaryPhoneHref={siteData.contacts.phones[0].href}
        whatsappEnabled={isWhatsAppEnabled()}
        whatsappHref={getWhatsAppUrl()}
        telegramEnabled={isTelegramEnabled()}
        telegramHref={getTelegramUrl()}
        telegramUsername={(siteData.telegram.username || '').trim().replace(/^@/, '')}
        giftDescription={siteData.giftDescription || ''}
        deliveryOptions={getDeliveryOptions()}
        deliveryConditions={getDeliveryConditions()}
        trustStrip={getTrustStrip()}
        warrantyText={siteData.warranty || ''}
      />
    </div>
  </section>
</BaseLayout>
