---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreMapBlock from '../../components/StoreMapBlock.astro';
import siteData from '../../data/site.json';
import { buildWhatsAppUrl } from '../../lib/catalog';

export function getStaticPaths() {
  return siteData.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const whatsappHref = buildWhatsAppUrl(service.whatsappPrefill);
const otherServices = siteData.services.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={`${service.title} в Санкт-Петербурге — SUPER STORE ТРЦ «РИО»`}
  description={`${service.summary} Офлайн-магазин техники SUPER STORE: Санкт-Петербург, ул. Фучика, д. 2, ТРЦ «РИО», ежедневно 10:00–22:00.`}
  canonicalPath={`/services/${service.slug}/`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14 space-y-12">
    <nav aria-label="Хлебные крошки" class="text-xs font-medium text-fg-muted flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-brand-link">Главная</a>
      <span aria-hidden="true">/</span>
      <a href="/services/" class="hover:text-brand-link">Услуги</a>
      <span aria-hidden="true">/</span>
      <span class="text-fg">{service.shortTitle}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 rounded-3xl bg-bg-card border border-line p-6 sm:p-10 shadow-card space-y-6">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-fg tracking-tight leading-tight">
          {service.title}
        </h1>
        <p class="text-base sm:text-lg text-fg-muted leading-relaxed">
          {service.summary}
        </p>

        <div class="pt-4 border-t border-line space-y-3">
          <h2 class="text-lg font-bold text-fg">Ключевые особенности</h2>
          <ul class="space-y-3">
            {service.highlights.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base text-fg">
                <span class="w-6 h-6 rounded-lg bg-brand-soft text-brand-link font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        {service.slug === 'data-transfer' && (
          <div class="p-5 rounded-2xl bg-bg-muted border border-line space-y-2">
            <h3 class="text-base font-bold text-fg">
              Установка приложений, которых нет в App Store
            </h3>
            <p class="text-sm text-fg-muted">
              Мы также подготовили специального Telegram-бота для подсказок по установке Сбербанка, ВКонтакте, Авито и других приложений:{' '}
              <a
                href={siteData.contacts.messengers.appsTelegramBot.domain}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-link font-semibold underline underline-offset-2"
              >
                {siteData.contacts.messengers.appsTelegramBot.label}
              </a>.
            </p>
          </div>
        )}

        <div class="pt-4 flex flex-wrap gap-3">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            data-goal="click_whatsapp"
            class="px-6 py-3.5 rounded-xl bg-brand hover:bg-brand-hover text-white text-sm sm:text-base font-bold transition-colors"
          >
            Проконсультироваться в WhatsApp
          </a>
          <a
            href={siteData.contacts.phones[0].href}
            data-goal="click_phone"
            class="px-6 py-3.5 rounded-xl bg-bg-muted hover:bg-line border border-line text-sm sm:text-base font-bold text-fg tabular-nums transition-colors"
          >
            Позвонить {siteData.contacts.phones[0].display}
          </a>
        </div>
      </div>

      <aside class="lg:col-span-4 rounded-3xl bg-bg-card border border-line p-6 shadow-card space-y-4">
        <h2 class="text-base font-bold text-fg">Другие услуги магазина</h2>
        <div class="space-y-2">
          {otherServices.map((s) => (
            <a
              href={`/services/${s.slug}/`}
              class="block p-3.5 rounded-2xl bg-bg-muted hover:border-brand border border-transparent transition-colors"
            >
              <div class="text-sm font-bold text-fg">{s.shortTitle}</div>
              <div class="text-xs text-fg-muted mt-0.5 line-clamp-2">{s.summary}</div>
            </a>
          ))}
        </div>
      </aside>
    </div>

    <section class="space-y-4">
      <h2 class="text-2xl font-extrabold text-fg">Где воспользоваться услугой</h2>
      <StoreMapBlock />
    </section>
  </div>
</BaseLayout>
