---
import '../styles/global.css';
import siteData from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { ImageAsset } from '../lib/catalog';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  lcpAsset?: ImageAsset | null;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  lcpAsset = null,
  jsonLd,
} = Astro.props;

// Enforce zero-emoji rule on meta title & description
const stripEmoji = (str: string) =>
  str.replace(/[\p{Extended_Pictographic}\uFE0F]/gu, '').replace(/\s+/g, ' ').trim();

const cleanTitle = stripEmoji(title);
const cleanDesc = stripEmoji(description);
const siteOrigin = Astro.site ? Astro.site.origin : siteData.brand.domain;
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ElectronicsStore',
  '@id': `${siteOrigin}/#store`,
  name: siteData.brand.seoName,
  alternateName: siteData.brand.shortName,
  url: siteOrigin,
  image: `${siteOrigin}/og-default.jpg`,
  telephone: siteData.contacts.phones[0].raw,
  contactPoint: siteData.contacts.phones.map((p) => ({
    '@type': 'ContactPoint',
    telephone: p.raw,
    contactType: 'sales',
    areaServed: 'RU-SPE',
    availableLanguage: ['Russian'],
  })),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${siteData.contacts.address.street}, ${siteData.contacts.address.mall}`,
    addressLocality: siteData.contacts.address.city,
    postalCode: siteData.contacts.address.postalCode,
    addressCountry: 'RU',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteData.contacts.address.coordinates.lat,
    longitude: siteData.contacts.address.coordinates.lon,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '10:00',
      closes: '22:00',
    },
  ],
  paymentAccepted: 'Cash, Credit Card, QR, Credit',
  currenciesAccepted: 'RUB',
};

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const allSchemas = [localBusinessSchema, ...extraSchemas];
const metrikaRaw = siteData.integrations.metrikaId;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDesc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Self-hosted Manrope Cyrillic + Latin (400/600) font preloads -->
    <link
      rel="preload"
      href="/fonts/manrope-cyrillic-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-cyrillic-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {lcpAsset && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={lcpAsset.avifSrcset}
        imagesizes="(max-width: 640px) 92vw, 520px"
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6D28D9" />

    <!-- Open Graph -->
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteData.brand.seoName} />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-fg">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[120] focus:px-4 focus:py-2.5 focus:rounded-xl focus:bg-btn focus:text-white focus:font-semibold"
    >
      Перейти к основному содержимому
    </a>

    <Header />

    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>

    <Footer />
    <MobileStickyBar />
    <CookieBanner />

    <!-- Yandex.Metrika Integration ([METRIKA_ID] placeholder — never reuses old constructor counter) -->
    <script is:inline define:vars={{ metrikaRaw }}>
      (function () {
        var isConfigured = /^\d+$/.test(metrikaRaw);
        window.__SUPERSTORE_METRIKA_ID__ = isConfigured ? Number(metrikaRaw) : null;

        function bootMetrika() {
          if (!isConfigured || window.__metrikaBooted) return;
          window.__metrikaBooted = true;
          (function (m, e, t, r, i, k, a) {
            m[i] =
              m[i] ||
              function () {
                (m[i].a = m[i].a || []).push(arguments);
              };
            m[i].l = 1 * new Date();
            for (var j = 0; j < document.scripts.length; j++) {
              if (document.scripts[j].src === r) return;
            }
            (k = e.createElement(t)),
              (a = e.getElementsByTagName(t)[0]),
              (k.async = 1),
              (k.src = r),
              a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

          window.ym(Number(metrikaRaw), 'init', {
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
            webvisor: false,
          });
        }

        try {
          if (localStorage.getItem('superstore_cookie_consent') === 'accepted') {
            bootMetrika();
          }
        } catch (e) {}

        window.addEventListener('superstore:analytics-consent', bootMetrika);

        // Global goal tracking delegation for phone, WhatsApp, Viber, and stock inquiries
        document.addEventListener('click', function (ev) {
          var el = ev.target && ev.target.closest ? ev.target.closest('[data-goal]') : null;
          if (!el) return;
          var goal = el.getAttribute('data-goal');
          if (!goal) return;
          if (window.__SUPERSTORE_METRIKA_ID__ && typeof window.ym === 'function') {
            window.ym(window.__SUPERSTORE_METRIKA_ID__, 'reachGoal', goal);
          }
        });
      })();
    </script>

    <!-- Desktop (≥768px) click-to-copy for phone links: keeps the real tel: link,
         preventDefault only on desktop; mobile keeps the standard tel: behaviour.
         Falls back to selecting the number when the Clipboard API is unavailable. -->
    <script is:inline>
      (function () {
        var desktop = window.matchMedia('(min-width: 768px)');
        document.addEventListener('click', function (ev) {
          var a = ev.target && ev.target.closest ? ev.target.closest('[data-copy-phone]') : null;
          if (!a || !desktop.matches) return;
          ev.preventDefault();
          var number = a.getAttribute('data-copy-phone') || (a.textContent || '').trim();
          var selectFallback = function () {
            try {
              var r = document.createRange();
              r.selectNodeContents(a);
              var s = window.getSelection();
              s.removeAllRanges();
              s.addRange(r);
            } catch (e) {}
          };
          var showNote = function () {
            var note = document.createElement('span');
            note.setAttribute('role', 'status'); // implicit aria-live="polite"
            note.textContent = 'Номер скопирован';
            note.style.cssText =
              'position:absolute;top:100%;left:0;margin-top:4px;white-space:nowrap;' +
              'font-size:13px;line-height:1.4;color:#6B6B76;z-index:10;';
            if (getComputedStyle(a).position === 'static') a.style.position = 'relative';
            a.appendChild(note);
            setTimeout(function () { note.remove(); }, 2000);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(number).then(showNote, selectFallback);
          } else {
            selectFallback();
          }
        });
      })();
    </script>

    <!-- One motion system: fade + 20px translate on scroll (respects prefers-reduced-motion) -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              // Reveal when intersecting — or when already scrolled past
              // (programmatic jumps can skip intermediate frames).
              if (entry.isIntersecting || entry.boundingClientRect.bottom < 0) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
