---
import siteData from '../data/site.json';
import type { ProductModelGroup } from '../lib/catalog';
import { formatPrice, getImageAsset } from '../lib/catalog';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  group: ProductModelGroup;
}

const { group } = Astro.props;
const primaryPhoneHref = siteData.contacts.phones[0].href;

// Display-only: clean model name on the tile; the full configuration stays on the product page.
const displayName = group.modelTitle.replace(' с дисководом', '');

// Prefer the #F7F7F9 background variant so the render melts into the tile surface;
// fall back to the base key for owner-supplied photos that have no -f7 variant.
const baseKey = group.defaultImageKey;
const resolvedKey = baseKey
  ? getImageAsset(`${baseKey}-f7`)
    ? `${baseKey}-f7`
    : baseKey
  : null;

const cheapest = group.items.filter((i) => i.price === group.minPrice);
const defaultSku =
  cheapest.find((i) => i.color === 'Glacier') || cheapest[0] || group.items[0];

const leadPayload = JSON.stringify({
  type: 'reserve',
  model: group.modelTitle,
  title: defaultSku.title,
  color: defaultSku.color
    ? defaultSku.colorRu && defaultSku.colorRu !== defaultSku.color
      ? `${defaultSku.color} (${defaultSku.colorRu})`
      : defaultSku.color
    : null,
  storage: defaultSku.storage,
  sim: defaultSku.sim,
  price: defaultSku.price,
});
---

<article class="flex flex-col items-start">
  <a
    href={group.url}
    class="group block w-full product-tile"
  >
    <div
      class="aspect-square flex items-center justify-center overflow-hidden"
      style="background-color: var(--surface);"
    >
      <OptimizedImage
        imageKey={resolvedKey}
        alt={group.modelTitle}
        sizes="(max-width: 640px) 44vw, (max-width: 1024px) 30vw, 260px"
        class="w-full h-full"
        imgClass="w-full h-full object-cover object-left"
        placeholderLabel="Фото уточняется у менеджера"
      />
    </div>
    <div class="pt-3 pb-1">
      <h3 class="text-[1rem] font-semibold text-fg leading-snug m-0">{displayName}</h3>
      <div class="mt-1">
        {group.inStock ? (
          <span class="status-badge status-badge--in">
            <span class="status-dot" aria-hidden="true"></span>
            В наличии
          </span>
        ) : (
          <span class="type-small text-fg-muted">Под заказ</span>
        )}
      </div>
      <p class="text-[0.9375rem] text-fg-muted mt-1 mb-0 tabular-nums">
        {group.hasMultipleConfigs ? `от ${formatPrice(group.minPrice)}` : formatPrice(group.minPrice)}
      </p>
    </div>
  </a>
  <a
    href={primaryPhoneHref}
    data-lead-open={leadPayload}
    class="arrow-link !text-[0.875rem] mt-1"
  >
    Забронировать
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</article>
