---
/**
 * Single source of the brand logo.
 * Owner drops `src/assets/brand/logo-mark.svg` (or `.png`) and/or `logo-full.svg` manually.
 * Until those files exist, renders ONLY the text wordmark "SUPER STORE" (no invented mark).
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
}

const { size = 28, withWordmark = true } = Astro.props;

const fullSvgModules = import.meta.glob<string>('../assets/brand/logo-full.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const markSvgModules = import.meta.glob<string>('../assets/brand/logo-mark.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const markPngModules = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  '../assets/brand/logo-mark.png',
  { eager: true }
);

const fullSvg = Object.values(fullSvgModules)[0] ?? null;
const markSvg = Object.values(markSvgModules)[0] ?? null;
const markPng = Object.values(markPngModules)[0]?.default ?? null;
---

{withWordmark && fullSvg ? (
  <span class="logo-lockup logo-full" style={`height: ${size}px;`} set:html={fullSvg} />
) : (
  <span class="logo-lockup" style="gap: 10px;">
    {markSvg ? (
      <span
        class="logo-mark"
        style={`width: ${size}px; height: ${size}px;`}
        aria-hidden="true"
        set:html={markSvg}
      />
    ) : markPng ? (
      <img
        src={markPng.src}
        alt=""
        width={size}
        height={size}
        aria-hidden="true"
        class="logo-mark"
      />
    ) : null}
    {(withWordmark || (!markSvg && !markPng)) && (
      <span class="logo-wordmark">SUPER STORE</span>
    )}
  </span>
)}

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
  }
  .logo-full :global(svg),
  .logo-mark :global(svg) {
    height: 100%;
    width: auto;
    display: block;
  }
  .logo-wordmark {
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
    line-height: 1;
    font-size: 15px;
  }
</style>
