---
/**
 * Single source of the store logo: flat violet rounded square with the white "S" monogram.
 * No gradient, no small text inside. Used by Header (28px) and Footer (32px).
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
}

const { size = 28, withWordmark = true } = Astro.props;
---

<span class="logo-lockup" style={`gap: 10px;`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="40" height="40" rx="10" fill="#6D28D9"></rect>
    <path
      d="M28.5 11H15.5C13.0147 11 11 13.0147 11 15.5C11 17.9853 13.0147 20 15.5 20H24.5C26.9853 20 29 22.0147 29 24.5C29 26.9853 26.9853 29 24.5 29H11.5"
      stroke="#FFFFFF"
      stroke-width="4.5"
      stroke-linecap="round"
    ></path>
  </svg>
  {withWordmark && <span class="logo-wordmark">SUPER STORE</span>}
</span>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
  }
  .logo-wordmark {
    font-weight: 600;
    color: #111111;
    letter-spacing: 0.02em;
    line-height: 1;
    font-size: 15px;
  }
</style>
