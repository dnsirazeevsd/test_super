---
/**
 * Trade-In / buyback estimator — /services/#trade-in only.
 * Compact borderless #F7F7F9 surface block (radius 12, zero borders/shadows) with a tight
 * 3-column select grid (desktop, gap 16px) and two side-by-side actions:
 *   1. filled WhatsApp button (prefilled deep link)
 *   2. text-arrow Telegram link (same prefill text)
 * Native selects with visible labels; the only line is a 1px #E6E6EA bottom divider.
 * No prices, timings or percentages anywhere. Works without JS (plain links as fallback).
 */
import MessengerIcon from './MessengerIcon.astro';
import siteData from '../data/site.json';
import { buildWhatsAppUrl } from '../lib/catalog';

const telegramUrl = siteData.contacts.messengers.telegram.url;
const fallbackWaHref = buildWhatsAppUrl(
  'Здравствуйте! Хочу оценить устройство для Trade-In или выкупа.'
);
const fallbackTgHref = `${telegramUrl}?text=${encodeURIComponent(
  'Здравствуйте! Хочу оценить устройство для Trade-In или выкупа.'
)}`;

const models = [
  'iPhone 18 Pro Max',
  'iPhone 18 Pro',
  'iPhone 17 Pro Max',
  'iPhone 17 Pro',
  'iPhone 17 Air',
  'iPhone 17',
  'iPhone 16 Pro Max',
  'iPhone 16 Pro',
  'iPhone 16',
  'iPhone 15 Pro Max',
  'iPhone 15 Pro',
  'iPhone 15',
  'iPhone 14 Pro Max',
  'iPhone 14 Pro',
  'iPhone 14',
  'iPhone 13 или более ранняя модель',
  'Другое устройство Apple',
];
const storages = ['64 ГБ', '128 ГБ', '256 ГБ', '512 ГБ', '1 ТБ', '2 ТБ', 'Не помню'];
const conditions = [
  'Идеальное (без следов)',
  'Хорошее (мелкие царапины)',
  'Есть сколы или трещины',
  'Требует ремонта',
];
---

<div
  class="rounded-xl p-6 lg:p-7 mt-2"
  style="background-color: var(--surface);"
  data-trade-in-estimator
  data-telegram-url={telegramUrl}
>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-5">
    <div>
      <label for="ti-model" class="type-small font-semibold text-fg block mb-1">
        Модель
      </label>
      <select id="ti-model" data-estimator-field="model" class="estimator-select">
        {models.map((m) => <option value={m}>{m}</option>)}
      </select>
    </div>
    <div>
      <label for="ti-storage" class="type-small font-semibold text-fg block mb-1">
        Память
      </label>
      <select id="ti-storage" data-estimator-field="storage" class="estimator-select">
        {storages.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>
    <div>
      <label for="ti-condition" class="type-small font-semibold text-fg block mb-1">
        Состояние
      </label>
      <select id="ti-condition" data-estimator-field="condition" class="estimator-select">
        {conditions.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
  </div>

  <!-- Two side-by-side actions -->
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-6">
    <a
      href={fallbackWaHref}
      target="_blank"
      rel="noopener noreferrer"
      data-goal="trade_in_request"
      data-estimator-cta
      class="btn"
    >
      Узнать оценку в WhatsApp
    </a>
    <a
      href={fallbackTgHref}
      target="_blank"
      rel="noopener noreferrer"
      data-goal="click_telegram"
      data-estimator-cta-telegram
      class="inline-flex items-center gap-2 font-semibold text-fg hover:text-brand transition-colors"
    >
      <MessengerIcon name="telegram" size={18} />
      Узнать оценку в Telegram
      <svg class="w-4 h-4 tg-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

  <p class="type-small text-fg-muted mt-5 mb-0">
    Точную оценку менеджер назовёт после осмотра устройства в магазине.
  </p>
</div>

<style>
  /* Borderless selects: the only line is a 1px #E6E6EA bottom divider */
  .estimator-select {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--divider);
    border-radius: 0;
    padding: 10px 0;
    font-size: 16px; /* >=16px prevents mobile zoom-on-focus */
    color: var(--text);
    appearance: auto; /* keep the native picker arrow */
  }
  .tg-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  a:hover .tg-arrow {
    transform: translateX(3px);
  }
</style>

<script>
 document.addEventListener('astro:page-load', () => {
  // Upgrade both deep links with the selected values (plain links work without JS).
  const root = document.querySelector('[data-trade-in-estimator]');
  if (root) {
    const wa = root.querySelector<HTMLAnchorElement>('[data-estimator-cta]');
    const tg = root.querySelector<HTMLAnchorElement>('[data-estimator-cta-telegram]');
    const fields = root.querySelectorAll<HTMLSelectElement>('[data-estimator-field]');
    const baseMessage = 'Здравствуйте! Хочу оценить устройство для Trade-In или выкупа.';
    const telegramUrl = root.getAttribute('data-telegram-url') || '';

    const buildText = () => {
      const [model, storage, condition] = Array.from(fields).map((f) => f.value);
      return `${baseMessage} Модель: ${model}, память: ${storage}, состояние: ${condition}.`;
    };
    const buildHref = (kind: 'wa' | 'tg') => {
      const text = buildText();
      return kind === 'wa'
        ? `https://api.whatsapp.com/send?phone=79312020078&text=${encodeURIComponent(text)}`
        : `${telegramUrl}?text=${encodeURIComponent(text)}`;
    };
    const refresh = () => {
      if (wa) wa.href = buildHref('wa');
      if (tg) tg.href = buildHref('tg');
    };

    fields.forEach((f) => f.addEventListener('change', refresh));
    wa?.addEventListener('click', refresh);
    tg?.addEventListener('click', refresh);
  }

 });
</script>
