---
/**
 * Trade-In estimator — /services/#trade-in.
 * Compact borderless #F7F7F9 surface block (radius 12, zero borders/shadows) with a
 * 3-column select grid (desktop, gap 16px) and primary CTA «Отправить заявку»
 * opening the accessible Lead Modal (passing model, storage, condition — zero prices).
 * Secondary text links «Узнать оценку в Telegram / WhatsApp →» are prefilled with the
 * selected model, storage and condition (Telegram prefilled only with a username).
 * Without JS, falls back to the primary store phone `tel:` link.
 */
import MessengerIcon from './MessengerIcon.astro';
import siteData from '../data/site.json';
import { getTelegramUrl, getWhatsAppUrl, isTelegramEnabled, isWhatsAppEnabled } from '../lib/catalog';

const primaryPhoneHref = siteData.contacts.phones[0].href;
const telegramHref = getTelegramUrl();
const showTelegram = isTelegramEnabled() && Boolean(telegramHref);
const whatsappHref = getWhatsAppUrl();
const showWhatsApp = isWhatsAppEnabled() && Boolean(whatsappHref);
const telegramUsername = (siteData.telegram?.username || '').trim();

const models = [
  'iPhone 18 Pro Max',
  'iPhone 18 Pro',
  'iPhone 17 Pro Max',
  'iPhone 17 Pro',
  'iPhone 17 Air',
  'iPhone 17',
  'iPhone 16 Pro Max',
  'iPhone 16 Pro',
  'iPhone 16',
  'iPhone 15 Pro Max',
  'iPhone 15 Pro',
  'iPhone 15',
  'iPhone 14 Pro Max',
  'iPhone 14 Pro',
  'iPhone 14',
  'iPhone 13 или более ранняя модель',
  'Другое устройство Apple',
];
const storages = ['64 ГБ', '128 ГБ', '256 ГБ', '512 ГБ', '1 ТБ', '2 ТБ', 'Не помню'];
const conditions = [
  'Идеальное (без следов)',
  'Хорошее (мелкие царапины)',
  'Есть сколы или трещины',
  'Требует ремонта',
];

// Prefilled Trade-In text; the Telegram link carries it only when a username is set.
const defaultTradeInText = `Здравствуйте! Интересует Trade-In: ${models[0]}, ${storages[0]}, ${conditions[0]}.`;
const telegramHrefWithText = showTelegram
  ? (telegramUsername ? `${telegramHref}?text=${encodeURIComponent(defaultTradeInText)}` : telegramHref)
  : '';
const whatsappHrefWithText = showWhatsApp
  ? `${whatsappHref}?text=${encodeURIComponent(defaultTradeInText)}`
  : '';
---

<div
  class="rounded-xl p-6 lg:p-7 mt-2"
  style="background-color: var(--surface);"
  data-trade-in-estimator
  data-tg-href={telegramHref}
  data-wa-href={whatsappHref}
  data-tg-username={telegramUsername}
>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-5">
    <div>
      <label for="ti-model" class="type-small font-semibold text-fg block mb-1">
        Модель
      </label>
      <select id="ti-model" data-estimator-field="model" class="estimator-select">
        {models.map((m) => <option value={m}>{m}</option>)}
      </select>
    </div>
    <div>
      <label for="ti-storage" class="type-small font-semibold text-fg block mb-1">
        Память
      </label>
      <select id="ti-storage" data-estimator-field="storage" class="estimator-select">
        {storages.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>
    <div>
      <label for="ti-condition" class="type-small font-semibold text-fg block mb-1">
        Состояние
      </label>
      <select id="ti-condition" data-estimator-field="condition" class="estimator-select">
        {conditions.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-6">
    <a
      href={primaryPhoneHref}
      data-goal="trade_in_request"
      data-estimator-cta
      class="btn"
    >
      Отправить заявку
    </a>
    {showTelegram && (
      <a
        href={telegramHrefWithText}
        target="_blank"
        rel="noopener noreferrer"
        data-goal="click_telegram"
        data-ti-link="telegram"
        class="inline-flex items-center gap-2 min-h-[44px] font-semibold text-fg hover:text-brand transition-colors"
      >
        <MessengerIcon name="telegram" size={18} />
        Узнать оценку в Telegram
        <svg class="w-4 h-4 tg-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    )}
    {showWhatsApp && (
      <a
        href={whatsappHrefWithText}
        target="_blank"
        rel="noopener noreferrer"
        data-goal="click_whatsapp"
        data-ti-link="whatsapp"
        class="inline-flex items-center gap-2 min-h-[44px] font-semibold text-fg hover:text-brand transition-colors"
      >
        <MessengerIcon name="whatsapp" size={18} />
        Узнать оценку в WhatsApp
        <svg class="w-4 h-4 tg-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    )}
  </div>

  <p class="type-small text-fg-muted mt-5 mb-0">
    Точную оценку менеджер назовёт после осмотра устройства в магазине.
  </p>
</div>

<style>
  /* Borderless selects: the only line is a 1px #E6E6EA bottom divider */
  .estimator-select {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--divider);
    border-radius: 0;
    padding: 10px 0;
    font-size: 16px; /* >=16px prevents mobile zoom-on-focus */
    color: var(--text);
    appearance: auto;
  }
  .tg-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  a:hover .tg-arrow {
    transform: translateX(3px);
  }
</style>

<script>
  import { openLeadModal } from '../lib/lead';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-trade-in-estimator]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const cta = root.querySelector<HTMLAnchorElement>('[data-estimator-cta]');
    const modelSel = root.querySelector<HTMLSelectElement>('[data-estimator-field="model"]');
    const storageSel = root.querySelector<HTMLSelectElement>('[data-estimator-field="storage"]');
    const conditionSel = root.querySelector<HTMLSelectElement>('[data-estimator-field="condition"]');

    // Keep the secondary messenger links prefilled with the selected model,
    // storage and condition. Telegram carries ?text= only when a username is set.
    const tgBase = root.dataset.tgHref || '';
    const waBase = root.dataset.waHref || '';
    const tgUsername = (root.dataset.tgUsername || '').trim();
    const tgLink = root.querySelector<HTMLAnchorElement>('[data-ti-link="telegram"]');
    const waLink = root.querySelector<HTMLAnchorElement>('[data-ti-link="whatsapp"]');

    const updateMessengerLinks = () => {
      const text = `Здравствуйте! Интересует Trade-In: ${
        modelSel?.value || ''
      }, ${storageSel?.value || ''}, ${conditionSel?.value || ''}.`;
      if (tgLink && tgBase) {
        tgLink.setAttribute('href', tgUsername ? `${tgBase}?text=${encodeURIComponent(text)}` : tgBase);
      }
      if (waLink && waBase) {
        waLink.setAttribute('href', `${waBase}?text=${encodeURIComponent(text)}`);
      }
    };

    updateMessengerLinks();
    [modelSel, storageSel, conditionSel].forEach((sel) =>
      sel?.addEventListener('change', updateMessengerLinks)
    );

    cta?.addEventListener('click', (ev) => {
      ev.preventDefault();
      openLeadModal(
        {
          type: 'trade-in',
          model: modelSel?.value || null,
          storage: storageSel?.value || null,
          condition: conditionSel?.value || null,
        },
        cta
      );
    });
  });
</script>
