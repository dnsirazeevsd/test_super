---
import siteData from '../data/site.json';

const primaryPhone = siteData.contacts.phones[0];
---

<!-- Mobile-only slim bar: appears after scrolling past the hero; text links keep "one filled button per screen" true.
     Uses `inert` (not aria-hidden) while hidden so its focusable links are never in the tab order. -->
<div
  id="mobile-action-bar"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-bg pt-2.5 pb-[calc(10px+env(safe-area-inset-bottom))] px-5 opacity-0 translate-y-full motion-transition"
  role="region"
  aria-label="Быстрая связь с магазином"
  inert
>
  <div class="flex items-center justify-around">
    <a
      href={primaryPhone.href}
      data-goal="click_phone"
      class="type-small font-semibold tabular-nums whitespace-nowrap text-fg no-underline"
    >
      Позвонить
    </a>
    <span class="w-px h-4" style="background-color: var(--divider);" aria-hidden="true"></span>
    <a
      href={primaryPhone.href}
      data-lead-open='{"type":"reserve"}'
      class="type-small font-semibold whitespace-nowrap text-fg hover:text-brand transition-colors no-underline inline-flex items-center gap-1.5"
    >
      Забронировать
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Reveal the bar once the visitor scrolls past the hero section.
    const bar = document.getElementById('mobile-action-bar');
    const hero = document.getElementById('hero');
    const setShown = (shown: boolean) => {
      bar?.classList.toggle('opacity-0', !shown);
      bar?.classList.toggle('translate-y-full', !shown);
      if (shown) bar?.removeAttribute('inert');
      else bar?.setAttribute('inert', '');
    };

    if (bar && hero && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => setShown(!entry.isIntersecting),
        { threshold: 0.05 }
      );
      io.observe(hero);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    } else if (bar) {
      setShown(true);
    }
  });
</script>
