---
import siteData from '../data/site.json';
import { getYandexOrgLink } from '../lib/catalog';

const addr = siteData.contacts.address;
const mapLink = getYandexOrgLink() ?? addr.yandexMapsLink;
---

<div class="space-y-4">
  <div class="flex flex-wrap items-center gap-x-8 gap-y-2">
    <a
      href={mapLink}
      target="_blank"
      rel="noopener noreferrer"
      class="arrow-link arrow-link--muted type-small"
    >
      Открыть в Яндекс Картах
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <a
    href={mapLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Открыть магазин SUPER STORE в ТРЦ РИО на Яндекс Картах"
    class="block relative w-full aspect-[4/3] lg:aspect-[16/10] overflow-hidden group"
    style="background-color: var(--surface);"
  >
    <svg
      class="absolute inset-0 w-full h-full transition-transform duration-300 group-hover:scale-[1.01]"
      viewBox="0 0 800 500"
      fill="none"
      xmlns="http://w3.org"
      aria-hidden="true"
    >
      <rect width="800" height="500" fill="#F7F7F9" />
      <rect x="60" y="40" width="240" height="150" rx="14" fill="#FFFFFF" />
      <rect x="360" y="40" width="380" height="150" rx="14" fill="#FFFFFF" />
      <rect x="60" y="270" width="240" height="190" rx="14" fill="#FFFFFF" />
      <!-- RIO Mall footprint -->
      <rect x="365" y="270" width="300" height="175" rx="18" fill="#EFEFF3" stroke="#531C79" stroke-opacity="0.35" stroke-width="2" />
      <!-- Roads -->
      <path d="M0 235 H800" stroke="#E6E6EA" stroke-width="20" />
      <path d="M330 0 V500" stroke="#E6E6EA" stroke-width="16" />
      <text x="80" y="228" fill="#6B6B76" font-size="15" font-family="Manrope, sans-serif">улица Фучика</text>
      <text x="515" y="350" text-anchor="middle" fill="#111111" font-size="17" font-weight="600" font-family="Manrope, sans-serif">ТРЦ «РИО»</text>
      <text x="515" y="374" text-anchor="middle" fill="#6B6B76" font-size="13" font-family="Manrope, sans-serif">SUPER STORE · ул. Фучика, д.&nbsp;2</text>
      <!-- Pin -->
      <circle cx="515" cy="320" r="12" fill="#531C79" />
      <circle cx="515" cy="320" r="4" fill="#FFFFFF" />
    </svg>
  </a>
</div>
